<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the extended-solution workflow still needs DAXIF. -->
    <PackageReference Include="Delegate.Daxif" Version="5.6.0" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="StageDaxifRuntime" AfterTargets="Build">
    <ItemGroup>
      <!-- This legacy package ships dependencies as content, not NuGet dependencies. -->
      <DaxifRuntime Include="$(PkgDelegate_Daxif)/content/Daxif/bin/*.dll" />
      <DaxifRuntime Include="$(PkgDelegate_Daxif)/lib/net462/Delegate.Daxif.dll" />
    </ItemGroup>
    <!-- Remove stale dependencies when the restored package changes. -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)/Daxif/runtime" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/Daxif/runtime" />
    <Copy SourceFiles="@(DaxifRuntime)" DestinationFolder="$(MSBuildProjectDirectory)/Daxif/runtime" SkipUnchangedFiles="true" />
    <!-- Override the package's old JSON dependency with the pinned patched version. -->
    <Copy SourceFiles="$(TargetDir)Newtonsoft.Json.dll" DestinationFolder="$(MSBuildProjectDirectory)/Daxif/runtime" SkipUnchangedFiles="true" />
  </Target>
</Project>
