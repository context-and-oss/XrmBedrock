{
  "DATAVERSE_URL": "https://dev.crm4.dynamics.com",
  "DATAVERSE_CREDENTIAL_TYPE": "browser",
  "XrmSync": {
    "LogLevel": "Information",
    "Profiles": [
      {
        "Name": "webresources",
        "SolutionName": "templatesolutionname",
        "Sync": [
          {
            "Type": "Webresource",
            "FolderPath": "src/Dataverse/WebResources/dist",
            "FileExtensions": ["html", "js"],
            "NoDelete": true
          }
        ]
      }
    ]
  },
  "XrmDefinitelyTyped": {
    "OutputDirectory": "src/Dataverse/WebResources/typings",
    "WebNamespace": "XDT",
    "Generate": ["forms", "web"],
    "Solutions": ["templatesolutionname"],
    "Entities": ["account", "contact"]
  }
}
